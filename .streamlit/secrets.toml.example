# Salin ke .streamlit/secrets.toml (lokal) atau tempel di Streamlit Cloud: App settings > Secrets.
# File secrets.toml sudah masuk .gitignore. Jangan commit nilai asli.

[database]
# Connection string dari Supabase: Project Settings > Database > Connection string > pilih "Transaction pooler" (port 6543).
# Awalan postgresql:// otomatis diubah ke driver yang benar. Ganti [YOUR-PASSWORD] dengan sandi database Anda.
url = "postgresql://postgres.xxxxxxxx:[YOUR-PASSWORD]@aws-0-ap-southeast-1.pooler.supabase.com:6543/postgres"

[app]
# true di server: tombol "Perbarui data produk" diganti petunjuk karena butuh browser di komputer.
cloud = true
# Lapisan pengaman tambahan selain pembatasan email di Streamlit Cloud. Hapus baris ini bila tidak dipakai.
password = "ganti-dengan-kata-sandi-panjang"
